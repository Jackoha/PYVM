# Kernel config fragment for pyvm, applied on top of `make tinyconfig`.
# Keeps the kernel small so it boots quickly on an interpreted CPU.
# (A stock `make defconfig` kernel also boots on pyvm; it is just much slower.)

# --- CPU / platform: RV64GC, Sv39, QEMU-virt-like board
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
CONFIG_SOC_VIRT=y
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_SBI_V01=y
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- core userspace support
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y

# --- console: NS16550A UART (ttyS0) + SBI early console / hvc0
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y

# --- storage: virtio-mmio block device (/dev/vda) with ext2/3/4
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# --- RTC and power off
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_GOLDFISH=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y

# --- networking: virtio-net (eth0), IPv4, DHCP (udhcpc needs AF_PACKET)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_SYSCTL=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_ETHERNET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# --- entropy: pyvm seeds the kernel RNG through the device tree (rng-seed), and
# this makes the kernel credit it.  Without it the CRNG never initialises and
# getrandom() blocks forever, hanging anything that uses OpenSSL (curl, ssh).
CONFIG_RANDOM_TRUST_BOOTLOADER=y
